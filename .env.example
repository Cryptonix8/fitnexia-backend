DATABASE_URL=postgresql://postgres:1234@localhost:5433/fitnexia
PORT=3001

# Default admin created on db:migrate / db:seed (change password after first login in production)
# SEED_ADMIN_EMAIL=admin@fitnexia.com
# SEED_ADMIN_PASSWORD=admin123
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=3600
FRONTEND_URL=*

# Comma-separated Web + Android OAuth client IDs (token audience verification).
# Web ID → mobile EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID. Android ID → Google Cloud package + SHA-1 only.
# Web + Android + iOS OAuth client IDs (comma-separated, no spaces)
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com,your-android-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com

# Mercado Pago — public HTTPS base for webhooks and payment return URLs (no /v1 suffix).
# Local mock: omit MP token and use http://10.0.2.2:3001 (emulator) or LAN IP.
# Production / marketplace (Uruguay): must be HTTPS.
API_PUBLIC_URL=https://svganchordev.net/fitnexia-api
MEDIA_PUBLIC_URL=https://svganchordev.net/fitnexia-api
# Mercado Pago Developers → Webhooks:
#   https://svganchordev.net/fitnexia-api/v1/webhooks/mercadopago
# Mercado Pago Developers → OAuth redirect URI:
#   https://svganchordev.net/fitnexia-api/v1/payouts/mp/callback
PAYMENTS_ENABLED=true
DEFAULT_CURRENCY=UYU
# Platform commission for the Freemium (basic) instructor plan (default 8)
# BASIC_COMMISSION_PERCENT=8

# Production Access Token (APP_USR-…) or sandbox (TEST-…)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-your-production-access-token
# Same as access token for marketplace (platform collector)
MERCADOPAGO_PLATFORM_ACCESS_TOKEN=APP_USR-your-production-access-token

# Marketplace / split payouts (Option B) — Uruguay application
MERCADOPAGO_MARKETPLACE_ENABLED=true
MERCADOPAGO_APP_ID=your-client-id
MERCADOPAGO_CLIENT_SECRET=your-client-secret
MARKETPLACE_GYM_PAYEE=institution
MARKETPLACE_PASS_REVENUE=split_at_purchase
MARKETPLACE_REQUIRE_SELLER_CONNECT=true

# Optional webhook signature secret from MP Developers
# MERCADOPAGO_WEBHOOK_SECRET=
# PAYMENT_PENDING_MINUTES=30
# APP_DEEP_LINK_SCHEME=fitnexia
# PASSWORD_RESET_EXPIRES_MINUTES=60

# Email (required for instructor invite emails to reach Gmail/inbox)
# Gmail: enable 2FA, create an App Password, use that as SMTP_PASS
# Password-reset emails may land in Spam until recipients mark them as "Not spam".
# Set API_PUBLIC_URL to your public HTTPS API base so reset links use https:// instead of fitnexia://
# ANDROID_APP_PACKAGE must match app.json android.package for "Abrir Fitnexia" intent links on Android
# ANDROID_APP_PACKAGE=com.fitnexia.app
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gym@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=Fitnexia <your-gym@gmail.com>

# Push notifications (Firebase Cloud Messaging via firebase-admin)
# ─── MOBILE (not .env): place in project root ───────────────────────────────
#   google-services.json          ← Android (from Firebase Console)
#   GoogleService-Info.plist      ← iOS (from Firebase Console)
#
# ─── BACKEND .env: service account (different file!) ────────────────────────
# Firebase Console → Project settings → Service accounts → Generate new private key
# Save as backend/secrets/firebase-service-account.json (never commit)
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# Or one-line JSON (alternative to PATH):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"fitnexia-dcd75",...}
NOTIFICATIONS_SCHEDULER_ENABLED=true
# VERIFICATION_STORAGE=local
# VERIFICATION_S3_BUCKET=fitnexia-verification-private
# AWS_REGION=us-east-1
# VERIFICATION_REVIEW_BUSINESS_DAYS=5
