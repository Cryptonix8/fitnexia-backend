    "db:migrate-verification": "node scripts/migrate-verification.js",
    "db:migrate-recurring": "node scripts/migrate-recurring-classes.js",
    "db:migrate-v2": "node scripts/migrate-v2-features.js",
    "db:migrate-v3": "node scripts/migrate-v3-features.js",
    "db:migrate-live-streaming": "node scripts/migrate-live-streaming.js",
    "db:migrate-user-purge": "node scripts/migrate-user-purge.js",
