{
  "name": "fitnexia-api",
  "version": "1.0.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "db:migrate": "node src/db/migrate.js",
    "db:seed": "node scripts/seed-admin.js",
    "db:init": "node src/db/migrate.js",
    "db:migrate-passes": "node scripts/migrate-athlete-passes.js",
    "db:migrate-marketplace": "node scripts/migrate-mp-marketplace.js",
